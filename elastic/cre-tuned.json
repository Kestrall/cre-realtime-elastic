{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "1s",
    "index.compound_format": false,
    "index.default_pipeline": "cre-realtime",
    "index.sort.field": "@timestamp",
    "index.sort.order": "desc"
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "event_id":          { "type": "keyword", "doc_values": false },
      "@timestamp":        { "type": "date" },
      "generated_at":      { "type": "date", "index": false, "doc_values": false },
      "ingested_at":       { "type": "date", "index": false },
      "ingest_lag_ms":     { "type": "long", "index": false },
      "account_id":        { "type": "keyword" },
      "iban":              { "type": "keyword", "doc_values": false },
      "holder_name":       { "type": "text", "norms": false },
      "entity":            { "type": "keyword" },
      "operation_type":    { "type": "keyword" },
      "direction":         { "type": "keyword" },
      "amount":            { "type": "scaled_float", "scaling_factor": 100 },
      "currency":          { "type": "constant_keyword", "value": "EUR" },
      "balance_after":     { "type": "scaled_float", "scaling_factor": 100, "index": false },
      "channel":           { "type": "keyword" },
      "merchant_category": { "type": "keyword" },
      "city":              { "type": "keyword" },
      "status":            { "type": "keyword" },
      "label":             { "type": "match_only_text" }
    }
  }
}
